{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Python: Build CPU wheel",
      "type": "process",
      "command": "uv",
      "args": ["run", "--no-sync", "python", "scripts/build_cpu_wheel.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Python: Build RK3566 wheel",
      "type": "process",
      "command": "uv",
      "args": ["build", "--wheel"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Run Python: CPU",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "python",
        "examples/nanotracker_gui.py",
        "--device",
        "cpu"
      ],
      "problemMatcher": []
    },
    {
      "label": "Run Python: CUDA",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "python",
        "examples/nanotracker_gui.py",
        "--device",
        "cuda"
      ],
      "problemMatcher": []
    },
    {
      "label": "Python: List wheel contents",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "python",
        "-m",
        "zipfile",
        "-l",
        "${input:wheelPath}"
      ],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "wheelPath",
      "type": "promptString",
      "description": "Wheel file to inspect",
      "default": "dist/nanotracker-0.1.0-py3-none-any.whl"
    }
  ]
}
